# Docker Compose configuration (copy to .env). Backend-only settings for
# local development without Docker live in backend/.env.example.

APP_URL=http://localhost:8080
HTTP_PORT=8080

POSTGRES_USER=monetra
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=monetra

# Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
HASH_PEPPER=
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# true when served over HTTPS (required in production)
COOKIE_SECURE=false

# Leave SMTP_HOST empty locally to use the bundled Mailpit catcher
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Monetra <no-reply@your-domain.in>"

# none | amfi (official end-of-day mutual fund NAVs)
MARKET_DATA_PROVIDER=none

# Database backups (./backups). Set a passphrase to encrypt dumps with AES-256.
BACKUP_RETENTION_DAYS=14
BACKUP_PASSPHRASE=
