# ---------------------------------------------------------------------------
# Monetra backend configuration. Copy to backend/.env and adjust.
# Every value is validated at start-up (see src/config/env.ts).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://monetra:monetra@localhost:5432/monetra
TEST_DATABASE_URL=postgres://monetra:monetra@localhost:5432/monetra_test
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Redis (optional locally; required for JOBS_MODE=bullmq and shared rate limits)
REDIS_URL=redis://localhost:6379

# Security - generate fresh values for every environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (JWT secret / pepper)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (encryption key)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
DATA_ENCRYPTION_KEY=replace-with-base64-32-byte-key=
HASH_PEPPER=replace-with-a-random-pepper
COOKIE_SECURE=false

# Abuse protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1500
AUTH_RATE_LIMIT_MAX=20
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# Email (leave SMTP_HOST empty to log emails to the console in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Monetra <no-reply@monetra.local>"

# SMS for phone verification: "console" (development) or "webhook" (your provider)
SMS_PROVIDER=console
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# File storage
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
MAX_UPLOAD_MB=5

# Market data: "none" (manual prices only) or "amfi" (official AMFI end-of-day mutual fund NAVs)
MARKET_DATA_PROVIDER=none

# Background jobs: "inline" (in-process timer) or "bullmq" (Redis-backed queue)
JOBS_ENABLED=true
JOBS_MODE=inline
